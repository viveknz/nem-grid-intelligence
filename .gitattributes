# Normalize line endings for everyone who clones this repo, independent of
# their local core.autocrlf setting. Without this, Windows checkouts convert
# LF -> CRLF, which silently breaks shell scripts (bad shebang) and makes
# diffs noisy on files that started as LF.

* text=auto eol=lf

*.sh   text eol=lf
*.py   text eol=lf
*.sql  text eol=lf
*.md   text eol=lf
*.yaml text eol=lf
*.yml  text eol=lf
*.json text eol=lf

# Binary — do not touch
*.png  binary
*.jpg  binary
*.parquet binary
*.zip  binary
